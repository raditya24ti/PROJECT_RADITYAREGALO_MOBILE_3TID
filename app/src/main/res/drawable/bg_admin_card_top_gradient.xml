<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/admin_card" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/admin_border" />
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:height="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/admin_amber"
                android:endColor="@color/admin_red" />
            <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" />
        </shape>
    </item>
</layer-list>
