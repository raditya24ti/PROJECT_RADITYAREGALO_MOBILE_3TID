<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/admin_card" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/admin_border" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:bottom="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/admin_amber" />
            <size android:width="4dp" />
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
        </shape>
    </item>
</layer-list>
