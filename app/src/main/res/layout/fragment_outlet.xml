<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sabit_cream"
    android:orientation="vertical"
    tools:context=".OutletFragment">

    <!-- ==================== HEADER ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sabit_navy"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="30dp"
        android:paddingBottom="20dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/archivoblack"
            android:text="LOKASI OUTLET"
            android:textColor="@color/sabit_gold"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter"
            android:text="Temukan Rengginang Sabit terdekat"
            android:textColor="@color/white"
            android:alpha="0.8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ==================== DAFTAR CABANG ==================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- OUTLET 1: Pusat -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/archivo"
                        android:text="Outlet Pusat (Rumbai)"
                        android:textColor="@color/sabit_navy"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter"
                        android:lineSpacingExtra="2dp"
                        android:text="Jl. Umban Sari No. 1, Rumbai, Kota Pekanbaru, Riau."
                        android:textColor="@color/sabit_gray"
                        android:textSize="13sp" />

                    <!-- TAMBAHAN ID UNTUK TOMBOL PUSAT -->
                    <Button
                        android:id="@+id/btnRuteOutletPusat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/sabit_gold"
                        android:fontFamily="@font/inter"
                        android:text="Lihat di Peta"
                        android:textColor="@color/sabit_navy"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- OUTLET 2: Cabang -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/archivo"
                        android:text="Outlet Sudirman"
                        android:textColor="@color/sabit_navy"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter"
                        android:lineSpacingExtra="2dp"
                        android:text="Jl. Jend. Sudirman No. 123, Marpoyan Damai, Kota Pekanbaru, Riau."
                        android:textColor="@color/sabit_gray"
                        android:textSize="13sp" />

                    <!-- TAMBAHAN ID UNTUK TOMBOL CABANG -->
                    <Button
                        android:id="@+id/btnRuteOutletSudirman"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/sabit_gold"
                        android:fontFamily="@font/inter"
                        android:text="Lihat di Peta"
                        android:textColor="@color/sabit_navy"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>