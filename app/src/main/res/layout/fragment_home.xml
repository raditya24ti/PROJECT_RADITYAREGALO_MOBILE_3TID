<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sabit_cream"
    tools:context=".HomeFragment">

    <ScrollView
        android:id="@+id/scrollViewMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ==================== HEADER ==================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="Logo Rengginang Sabitt"
                    android:scaleType="centerInside"
                    android:src="@drawable/logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rengginang Sabit"
                        android:textColor="@color/sabit_navy"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/archivoblack" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Cita rasa tradisional, kualitas pilihan"
                        android:textColor="@color/sabit_gray"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter" />

                </LinearLayout>

                <!-- TOMBOL INFO (UNTUK TUTORIAL / ONBOARD SCREEN) -->
                <Button
                    android:id="@+id/btnInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Info"
                    android:layout_marginEnd="8dp"
                    android:textSize="11sp"
                    android:textColor="@color/sabit_navy"
                    android:fontFamily="@font/inter"
                    android:backgroundTint="@color/sabit_gold"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <Button
                    android:id="@+id/btnAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/inter"
                    android:backgroundTint="@color/sabit_navy"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

            </LinearLayout>

            <!-- GARIS AKSEN -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@color/sabit_gold" />

            <!-- ==================== BANNER PROMO (IMAGE SLIDER) ==================== -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerBanner"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="20dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clipToPadding="false" />

            <!-- ==================== HERO ==================== -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                app:cardBackgroundColor="@color/sabit_navy"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:id="@+id/tvPetaDistribusi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_peta_distribusi"
                        android:textColor="@color/sabit_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/archivo" />

                    <TextView
                        android:id="@+id/textSlogan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/hero_text"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/archivoblack" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Rengginang renyah dengan berbagai pilihan rasa."
                        android:textColor="@color/white"
                        android:alpha="0.85"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter" />

                    <!-- CTA -->

                    <Button
                        android:id="@+id/btnMasuk"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:text="Lihat Produk"
                        android:textColor="@color/sabit_navy"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:backgroundTint="@color/sabit_gold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ==================== PRODUK UNGGULAN ==================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvProdukUnggulan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Produk Unggulan"
                    android:textColor="@color/sabit_navy"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/archivo" />

                <TextView
                    android:id="@+id/tvLihatSemua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lihat_semua"
                    android:textColor="@color/sabit_gold"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

            </LinearLayout>

            <!-- ==================== RECYCLERVIEW (MENGGANTIKAN CARDVIEW MANUAL) ==================== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProdukUnggulan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:nestedScrollingEnabled="false" />

            <!-- ==================== AREA PENGUJIAN ==================== -->

            <TextView
                android:id="@+id/tvPengujian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Area Pengujian Materi"
                android:fontFamily="@font/inter" />

            <LinearLayout
                android:id="@+id/layoutPengujian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnToFourth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pertemuan 4"
                    android:fontFamily="@font/inter" />

                <Button
                    android:id="@+id/btnToFifth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pertemuan 5"
                    android:fontFamily="@font/inter" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>