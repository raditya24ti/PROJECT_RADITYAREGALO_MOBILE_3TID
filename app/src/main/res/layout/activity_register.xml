<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sabit_cream"
    android:orientation="vertical"
    tools:context=".RegisterActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/archivoblack"
                android:text="Registrasi Akun"
                android:textColor="@color/sabit_navy"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter"
                android:text="Silakan lengkapi data diri Anda"
                android:textColor="@color/sabit_gray"
                android:textSize="13sp" />

            <!-- Card Form Layout -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Input 1: Nama -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/archivo"
                        android:text="Nama Lengkap"
                        android:textColor="@color/sabit_navy"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/inputNama"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:drawable/editbox_background"
                        android:fontFamily="@font/inter"
                        android:hint="Masukkan nama lengkap"
                        android:inputType="textPersonName"
                        android:padding="10dp"
                        android:textSize="14sp" />

                    <!-- Input 2: No HP (inputType = number) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/archivo"
                        android:text="No. Handphone"
                        android:textColor="@color/sabit_navy"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/inputPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:drawable/editbox_background"
                        android:fontFamily="@font/inter"
                        android:hint="Contoh: 08123456789"
                        android:inputType="number"
                        android:padding="10dp"
                        android:textSize="14sp" />

                    <!-- Input 3: Username -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/archivo"
                        android:text="Username"
                        android:textColor="@color/sabit_navy"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/inputUsername"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:drawable/editbox_background"
                        android:fontFamily="@font/inter"
                        android:hint="Masukkan username"
                        android:inputType="text"
                        android:padding="10dp"
                        android:textSize="14sp" />

                    <!-- Input 4: Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/archivo"
                        android:text="Password"
                        android:textColor="@color/sabit_navy"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/inputPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:drawable/editbox_background"
                        android:fontFamily="@font/inter"
                        android:hint="Masukkan password"
                        android:inputType="textPassword"
                        android:padding="10dp"
                        android:textSize="14sp" />

                    <!-- Submit Button -->
                    <Button
                        android:id="@+id/btnSubmitRegister"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="@color/sabit_navy"
                        android:fontFamily="@font/inter"
                        android:text="Lanjut Verifikasi OTP"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>