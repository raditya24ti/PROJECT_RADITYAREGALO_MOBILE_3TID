<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvVisitorOutletNama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/archivo"
            android:textColor="@color/sabit_navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVisitorOutletAlamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/sabit_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvVisitorOutletJam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter"
            android:textColor="@color/sabit_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVisitorRute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/sabit_gold"
            android:fontFamily="@font/inter"
            android:text="Lihat di Peta"
            android:textColor="@color/sabit_navy"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
