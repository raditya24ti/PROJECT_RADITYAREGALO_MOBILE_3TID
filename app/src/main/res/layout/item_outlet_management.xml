<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_shortcut_row"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOutletNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:textColor="@color/admin_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOutletAlamat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/outfit"
                android:textColor="@color/admin_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chipJamBuka"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_amber"
            android:fontFamily="@font/outfit"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="08.00 - 21.00"
            android:textColor="@color/admin_brown"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/admin_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLihatPeta"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:fontFamily="@font/outfit"
            android:text="Lihat Peta"
            android:textColor="@color/admin_amber_dark"
            android:textSize="12sp"
            app:strokeColor="@color/admin_amber" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnOutletEdit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_box_amber"
            android:contentDescription="Edit"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/admin_amber_dark" />

        <ImageButton
            android:id="@+id/btnOutletDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_box_red"
            android:contentDescription="Delete"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/admin_red" />
    </LinearLayout>

</LinearLayout>
