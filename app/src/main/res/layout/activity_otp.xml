<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sabit_cream"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".OtpActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/archivoblack"
                android:text="Verifikasi OTP"
                android:textColor="@color/sabit_navy"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="Masukkan kode OTP (Gunakan No. HP yang didaftarkan saat registrasi)"
                android:textColor="@color/sabit_gray"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/inputOtp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@android:drawable/editbox_background"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:hint="Masukkan Kode OTP"
                android:inputType="number"
                android:letterSpacing="0.1"
                android:padding="10dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVerifyOtp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/sabit_gold"
                android:fontFamily="@font/inter"
                android:text="Verifikasi Simpan"
                android:textColor="@color/sabit_navy"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>