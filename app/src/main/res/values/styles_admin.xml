<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AdminPageTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/admin_text_title</item>
        <item name="fontFamily">@font/outfit</item>
    </style>

    <style name="AdminBreadcrumb">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/admin_text_title</item>
        <item name="fontFamily">@font/outfit</item>
    </style>

    <style name="AdminCardTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="fontFamily">@font/outfit</item>
    </style>

    <style name="AdminCardSubtitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/admin_muted</item>
        <item name="fontFamily">@font/outfit</item>
    </style>

    <style name="AdminLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/admin_label</item>
        <item name="fontFamily">@font/outfit</item>
    </style>

    <style name="AdminStatLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/admin_label</item>
        <item name="fontFamily">@font/outfit</item>
    </style>

    <style name="AdminStatValue">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="fontFamily">@font/outfit</item>
    </style>

    <style name="AdminInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/admin_border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/admin_amber</item>
    </style>
</resources>
